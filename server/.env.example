# No environment variables are required — the app runs entirely with
# in-memory demo data and no authentication.
#
# Optional, local dev only:
# PORT=5000
# CLIENT_URL=http://localhost:5173
#
# Optional: Gemini AI integration (for AI Copilot features).
# If not set, the app uses a built-in deterministic AI engine instead.
# GEMINI_API_KEY=your-gemini-api-key-here
